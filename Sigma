-- Logic
local correctPassword = "SigmaHub12"

checkKey.MouseButton1Click:Connect(function()
    if keyBox.Text == correctPassword then
        TweenService:Create(keyFrame, TweenInfo.new(0.5), {Transparency = 1}):Play()
        wait(0.5)
        keyFrame.Visible = false
        mainGui.Visible = true
        mainGui.Transparency = 1
        TweenService:Create(mainGui, TweenInfo.new(0.5), {Transparency = 0}):Play()
    end
end)

toggleBtn.MouseButton1Click:Connect(function()
    if keyFrame.Visible or mainGui.Visible then
        keyFrame.Visible = false
        mainGui.Visible = false
        toggleBtn.Text = "Open"
    else
        keyFrame.Visible = true
        toggleBtn.Text = "Close"
    end
end)
