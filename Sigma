-- Button Logic
ToggleButton.MouseButton1Click:Connect(function()
    KeyUI.Visible = not KeyUI.Visible
    ToggleButton.Text = KeyUI.Visible and "Close" or "Open"
end)

CheckKeyButton.MouseButton1Click:Connect(function()
    if KeyBox.Text == PASSWORD then
        TweenService:Create(KeyUI, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        wait(0.5)
        KeyUI.Visible = false
        MainGUI.Visible = true
    else
        KeyBox.Text = ""
        KeyBox.PlaceholderText = "Wrong password!"
    end
end)

-- Feature Logic
NoclipToggle.MouseButton1Click:Connect(function()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.CanCollide then
            v.CanCollide = false
        end
    end
end)

InfJumpToggle.MouseButton1Click:Connect(function()
    UserInputService.JumpRequest:Connect(function()
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").UseJumpPower = true
    end)
end)

InfHealthToggle.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = math.huge
        end
    end
end)

SpeedBox.FocusLost:Connect(function()
    local value = tonumber(SpeedBox.Text)
    if value then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = value
    end
end)

JumpBox.FocusLost:Connect(function()
    local value = tonumber(JumpBox.Text)
    if value then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").JumpPower = value
    end
end)

