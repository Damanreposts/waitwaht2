ScreenGui.ResetOnSpawn = false

-- Create UI Corner Function
local function applyUICorner(gui, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 10)
    corner.Parent = gui
end

